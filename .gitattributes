# Shell scripts must stay LF so `curl | bash` and Linux/macOS execution work.
*.sh text eol=lf
install.sh text eol=lf

# Fonts are binary: autocrlf must never touch the bundled flag font, on any
# checkout or CI runner (a converted byte makes it a font the browser rejects).
*.woff2 binary
*.woff binary

# Everything that runs on a router (busybox ash) stays LF on every checkout: a
# CRLF shebang is "/bin/sh^M: not found". The ipk builder normalises them too.
openwrt/** text eol=lf
