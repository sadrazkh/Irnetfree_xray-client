#!/bin/sh /etc/rc.common
# IRNetFree kill switch: loads the last armed snippet before any interface is up
# (firewall is S19 too and sorts first; network is S20). The service writes the
# snippet when the kill switch arms and deletes it when it disarms; this script
# only replays it at boot. `/etc/init.d/irnetfree-ks stop` lifts the block by hand.
START=19
STOP=90

snippet() {
	local data_dir
	config_load irnetfree
	config_get data_dir main data_dir /etc/irnetfree
	echo "$data_dir/killswitch.nft"
}

start() {
	local f store; f="$(snippet)"
	[ -s "$f" ] || return 0
	# "Connect when the router starts" off: the VPN stays off after this boot,
	# so there is nothing to block for — the service (S95) would only disarm
	# it, and the LAN must not be blocked for the minute in between
	store="$(dirname "$f")/store.json"
	if [ -s "$store" ] && [ "$(jsonfilter -i "$store" -e '@.settings.autoConnect' 2>/dev/null)" = "false" ]; then
		return 0
	fi
	nft -c -f "$f" 2>/dev/null && nft -f "$f"
}

stop() {
	nft delete table inet irnetfree_ks 2>/dev/null
	return 0
}
