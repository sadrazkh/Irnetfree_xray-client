<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility (Android 11+): without this the per-app picker sees
         almost none of the user's apps. Launchable apps are the ones to pick. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".IRApp"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.IRNetFree">

        <!-- singleTask: a link opened from a browser or a chat lands in the one
             copy of the app (onNewIntent), never as a second copy stacked on that
             app's task. The QR scanner and the system's consent dialogs still open
             on top of it in its own task, as before; a link arriving while the
             scanner is up closes the scanner (its result comes back cancelled). -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with IRNetFree: the app's own links (irnetfree://routing/…,
                 irnetfree://import/…) and a bare config link. Nothing is added
                 without the user's Add (core/DeepLink.kt, AppWork.receive). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="irnetfree" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="socks" />
                <data android:scheme="socks5" />
                <data android:scheme="wireguard" />
                <data android:scheme="wg" />
                <data android:scheme="tuic" />
                <data android:scheme="anytls" />
                <data android:scheme="hysteria2" />
                <data android:scheme="hy2" />
            </intent-filter>
            <!-- Share to IRNetFree: a text with config links or a subscription URL. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.XrayVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel for user-provided Xray configs" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Always-on VPN starts the service with the action above, at boot
                 too; onStartCommand connects the stored selection for it. -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!-- The Quick Settings tile (vpn/ConnectTile.kt): connect / disconnect
             the selected config without opening the app. -->
        <service
            android:name=".vpn.ConnectTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_vpn"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
